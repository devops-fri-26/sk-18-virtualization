Vagrant.configure("2") do |config|
    config.vm.box = "bento/ubuntu-24.04"
    config.vm.hostname = "barterapp"

    #dostop iz gostitelja
    config.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"
    config.vm.network "forwarded_port", guest: 443, host: 8443, host_ip: "127.0.0.1"

    # koda projekta bo v VM-ju v /repo
    config.vm.synced_folder "..", "/repo"

    config.vm.provider "virtualbox" do |vb|
        vb.name = "barterapp"
        vb.memory = 2048
        vb.cpus = 2
    end

    config.vm.provision "shell", path: "provision/01-base.sh"
    config.vm.provision "shell", path: "provision/02-postgres.sh"
    config.vm.provision "shell", path: "provision/03-redis.sh"
    config.vm.provision "shell", path: "provision/04-app.sh"
    config.vm.provision "shell", path: "provision/05-nginx.sh"
end


runcmd:
  - |
    set -e

    # Install Node.js 22
    curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource_setup.sh
    bash /tmp/nodesource_setup.sh
    apt-get install -y nodejs

    # Create application user
    useradd --system --create-home --shell /usr/sbin/nologin barterapp || true

    # Prepare application directories
    mkdir -p /opt/barterapp/backend
    mkdir -p /etc/barterapp

    chown -R barterapp:barterapp /opt/barterapp
    chmod 750 /opt/barterapp

    # Generate a random database password
    DB_PASSWORD=$(openssl rand -hex 32)

    # Store database credentials securely
    install -d -m 700 -o root -g root /etc/barterapp

    cat > /etc/barterapp/secrets.env <<EOF
    DB_PASSWORD=${DB_PASSWORD}
    EOF

    chmod 600 /etc/barterapp/secrets.env

    # Start PostgreSQL
    systemctl enable --now postgresql

    # Create PostgreSQL user if it does not exist
    if ! su - postgres -c "psql -tAc \"SELECT 1 FROM pg_roles WHERE rolname='barter'\"" | grep -q 1; then
      su - postgres -c "psql -c \"CREATE ROLE barter LOGIN PASSWORD '${DB_PASSWORD}'\""
    else
      su - postgres -c "psql -c \"ALTER ROLE barter WITH LOGIN PASSWORD '${DB_PASSWORD}'\""
    fi

    # Create database if it does not exist
    if ! su - postgres -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='barter'\"" | grep -q 1; then
      su - postgres -c "createdb -O barter barter"
    fi

    # Extract the backend source code
    mkdir -p /tmp/backend
    tar -xzf /tmp/backend.tar.gz -C /tmp

    # Apply the application database schema
    PGPASSWORD="${DB_PASSWORD}" psql \
      -v ON_ERROR_STOP=1 \
      -h 127.0.0.1 \
      -U barter \
      -d barter \
      -f /tmp/backend/db/schema.sql

    # Generate a separate Redis password
    REDIS_PASSWORD=$(openssl rand -hex 32)

    # Save Redis password in the secrets file
    printf '\nREDIS_PASSWORD=%s\n' "$REDIS_PASSWORD" >> /etc/barterapp/secrets.env
    chmod 600 /etc/barterapp/secrets.env

    # Configure Redis authentication
    sed -i -E '/^[[:space:]]*requirepass[[:space:]]+/d' /etc/redis/redis.conf
    printf '\nrequirepass %s\n' "$REDIS_PASSWORD" >> /etc/redis/redis.conf

    # Enable and restart Redis
    systemctl enable --now redis-server
    systemctl restart redis-server

    # Verify Redis authentication
    REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli ping

    # Deploy backend source code
    rsync -a --delete /tmp/backend/ /opt/barterapp/backend/

    # Create persistent upload directory
    mkdir -p /var/lib/barterapp/uploads
    chown -R barterapp:barterapp /var/lib/barterapp
    chmod 750 /var/lib/barterapp
    chmod 750 /var/lib/barterapp/uploads

    # Set application ownership
    chown -R barterapp:barterapp /opt/barterapp

    # Configure backend environment
    cat >> /etc/barterapp/secrets.env <<EOF
    DATABASE_URL=postgresql://barter:${DB_PASSWORD}@127.0.0.1:5432/barter
    REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379
    SESSION_TTL_SECONDS=86400
    PORT=3000
    UPLOAD_DIR=/var/lib/barterapp/uploads
    EOF

    chmod 600 /etc/barterapp/secrets.env

    # Install production and development dependencies
    cd /opt/barterapp/backend
    npm ci

    # Compile TypeScript
    npm run build

    # Remove development-only dependencies
    npm prune --omit=dev

    # Set ownership
    chown -R barterapp:barterapp /opt/barterapp

    # Create systemd service
    cat > /etc/systemd/system/barterapp.service <<'EOF'
    [Unit]
    Description=BarterApp Backend
    After=network.target postgresql.service redis-server.service
    Wants=postgresql.service redis-server.service

    [Service]
    Type=simple
    User=barterapp
    Group=barterapp
    WorkingDirectory=/opt/barterapp/backend
    EnvironmentFile=/etc/barterapp/secrets.env
    ExecStart=/usr/bin/node dist/index.js
    Restart=on-failure
    RestartSec=5

    NoNewPrivileges=true
    PrivateTmp=true

    [Install]
    WantedBy=multi-user.target
    EOF

    # Enable and start the backend
    systemctl daemon-reload
    systemctl enable --now barterapp

    # Create directory for TLS certificates
    mkdir -p /etc/nginx/ssl

    # Generate self-signed TLS certificate
    openssl req -x509 -nodes -days 365 \
      -newkey rsa:2048 \
      -keyout /etc/nginx/ssl/barterapp.key \
      -out /etc/nginx/ssl/barterapp.crt \
      -subj "/CN=barterapp-cloudinit" \
      -addext "subjectAltName=DNS:barterapp-cloudinit,DNS:localhost,IP:127.0.0.1"

    chmod 600 /etc/nginx/ssl/barterapp.key
    chmod 644 /etc/nginx/ssl/barterapp.crt

    # Configure Nginx authentication rate limiting
    cat > /etc/nginx/conf.d/barterapp-limits.conf <<'EOF'
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;
    EOF

    # Configure Nginx reverse proxy
    cat > /etc/nginx/sites-available/barterapp <<'EOF'
    server {
        listen 80 default_server;
        server_name _;

        client_max_body_size 5m;

        location /api/auth/ {
            limit_req zone=auth_limit burst=5 nodelay;
            limit_req_status 429;

            proxy_pass http://127.0.0.1:3000/auth/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:3000/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /uploads/ {
            alias /var/lib/barterapp/uploads/;
            try_files $uri =404;
        }

        location / {
            return 404;
        }
    }

    server {
        listen 443 ssl default_server;
        server_name _;

        ssl_certificate /etc/nginx/ssl/barterapp.crt;
        ssl_certificate_key /etc/nginx/ssl/barterapp.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        client_max_body_size 5m;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;

        location /api/auth/ {
            limit_req zone=auth_limit burst=5 nodelay;
            limit_req_status 429;

            proxy_pass http://127.0.0.1:3000/auth/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:3000/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /uploads/ {
            alias /var/lib/barterapp/uploads/;
            try_files $uri =404;
        }

        location / {
            return 404;
        }
    }
    EOF

    # Enable BarterApp site and disable default site
    rm -f /etc/nginx/sites-enabled/default
    ln -sf /etc/nginx/sites-available/barterapp /etc/nginx/sites-enabled/barterapp

    # Validate and start Nginx
    nginx -t
    systemctl enable --now nginx
    systemctl restart nginx

    # Configure UFW firewall
    ufw default deny incoming
    ufw default allow outgoing

    # Allow SSH (VirtualBox forwards host port 2222 to guest port 22)
    ufw allow 22/tcp

    # Allow HTTP and HTTPS
    ufw allow 80/tcp
    ufw allow 443/tcp

    # Enable firewall
    ufw --force enable

    # Configure Fail2ban SSH protection
    cat > /etc/fail2ban/jail.local <<'EOF'
    [DEFAULT]
    bantime = 10m
    findtime = 10m
    maxretry = 5

    [sshd]
    enabled = true
    backend = systemd
    port = 22
    EOF

    # Enable Fail2ban
    systemctl enable --now fail2ban
    systemctl restart fail2ban

    # Configure Prometheus scraping
    cat > /etc/prometheus/prometheus.yml <<'EOF'
    global:
      scrape_interval: 15s

    scrape_configs:
      - job_name: prometheus
        static_configs:
          - targets: ['127.0.0.1:9090']

      - job_name: node
        static_configs:
          - targets: ['127.0.0.1:9100']
    EOF

    # Enable Prometheus and Node Exporter
    systemctl enable --now prometheus
    systemctl enable --now prometheus-node-exporter

    # Restrict Node Exporter to localhost
    mkdir -p /etc/systemd/system/prometheus-node-exporter.service.d

    cat > /etc/systemd/system/prometheus-node-exporter.service.d/override.conf <<'EOF'
    [Service]
    ExecStart=
    ExecStart=/usr/bin/prometheus-node-exporter --web.listen-address=127.0.0.1:9100
    EOF

    # Restrict Prometheus to localhost
    mkdir -p /etc/systemd/system/prometheus.service.d

    cat > /etc/systemd/system/prometheus.service.d/override.conf <<'EOF'
    [Service]
    ExecStart=
    ExecStart=/usr/bin/prometheus --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/var/lib/prometheus/metrics2 --web.listen-address=127.0.0.1:9090
    EOF

    # Apply overrides and restart monitoring
    systemctl daemon-reload
    systemctl restart prometheus-node-exporter
    systemctl restart prometheus
